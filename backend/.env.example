# ==============================================================================
# SmartCV — Environment Configuration
# King Khalid University — College of Computer Science
# Supports SQLite (Default), MySQL, and Supabase (PostgreSQL)
# ==============================================================================

# Project & Security
PROJECT_NAME="SmartCV"
SECRET_KEY="smartcv-super-secret-jwt-key-2026-kku" # In production, generate via: openssl rand -hex 32
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Server Network & CORS
PORT=7860
# Comma-separated allowed frontend domains, or '*' for demo access
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app"

# Database Seeding on Startup
# Set to 'false' if database already contains data, or 'true' to auto-seed on clean boot
SEED_ON_STARTUP=false

# ------------------------------------------------------------------------------
# OPTION 1: SQLite (Default Zero-Config Local Run)
# ------------------------------------------------------------------------------
DATABASE_URL="sqlite:///./smartcv.db"

# ------------------------------------------------------------------------------
# OPTION 2: Supabase (PostgreSQL Cloud Database - Recommended for Production)
# ------------------------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Recommended (Pooler / IPv4 & IPv6):
# DATABASE_URL="postgresql://postgres.[project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require"
# Direct connection (port 5432):
# DATABASE_URL="postgresql://postgres:[your-password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require"
#
# Optional Supabase Storage API credentials:
# SUPABASE_URL="https://[project-ref].supabase.co"
# SUPABASE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# OPTION 3: MySQL (Local XAMPP/WAMP, Docker, or AWS RDS)
# ------------------------------------------------------------------------------
# DATABASE_URL="mysql+pymysql://root:password123@localhost:3306/smartcv?charset=utf8mb4"

# ------------------------------------------------------------------------------
# Hybrid Scorer Model Weights (Configurable)
# ------------------------------------------------------------------------------
WEIGHT_SBERT=0.50
WEIGHT_TFIDF=0.20
WEIGHT_SKILLS=0.30
